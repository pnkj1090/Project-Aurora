    <key>NSCalendarsUsageDescription</key>
    <string>Project Aurora needs read-only calendar access to provide schedule awareness when explicitly requested.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Project Aurora needs read-only calendar access to provide schedule awareness when explicitly requested.</string>
    <key>NSContactsUsageDescription</key>
    <string>Project Aurora needs read-only contacts access to search contact details when explicitly requested.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Project Aurora uses your microphone for real-time voice conversations when explicitly requested.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Project Aurora uses on-device speech recognition to transcribe your voice when explicitly requested.</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>com.projectaurora.deeplink</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>aurora</string>
            </array>
        </dict>
    </array>
