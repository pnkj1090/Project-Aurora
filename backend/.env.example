# Server Configuration
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# AI Provider Configuration
# Supported providers:
#   - "gemini" (Google Gemini 3.8 Flash, 1.5 Pro, etc.)
#   - "openai" (OpenAI gpt-4o-mini, gpt-4o, or OpenAI-compatible endpoints)
#   - "mock" (offline fallback for testing & local development)
AI_PROVIDER=gemini

# Model Configuration
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT=30.0
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

# API Keys (Stored ONLY on backend, NEVER exposed to client)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_API_KEY=

# Custom Provider Base URLs (optional overrides)
AI_BASE_URL=https://api.openai.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
